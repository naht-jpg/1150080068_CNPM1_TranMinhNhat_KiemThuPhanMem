<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  REGRESSION Suite - chạy tất cả groups (smoke + regression) → đọc cả 3 sheets.
  Lệnh: mvn test  (mặc định theo pom.xml)
-->
<suite name="BTTuan9_Bai3_Regression" verbose="1">

    <parameter name="browser" value="chrome"/>
    <parameter name="env"     value="dev"/>

    <!-- Smoke tests: SmokeCases sheet -->
    <test name="Smoke_Cases">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginExcelTest"/>
        </classes>
    </test>

    <!-- Regression tests: NegativeCases + BoundaryCases sheets -->
    <test name="Negative_Cases">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginExcelTest"/>
        </classes>
    </test>

</suite>
